# Public runtime
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=

# Server spam verification
TURNSTILE_SECRET_KEY=

# Server durable rate limiting and idempotency
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_HMAC_SECRET=

# Optional deployment adapter. Leave empty unless the host is explicitly trusted.
TRUSTED_CLIENT_IP_HEADER=

# Commerce cutover. Keep legacy_primary until every Gate E item is approved.
COMMERCE_MODE=legacy_primary
COMMERCE_LEGACY_STORE_URL=https://joyfound.calebjakes.com/
COMMERCE_RUNTIME_ENABLED=false

# Private platform test entry. Sensitive; at least 32 random characters.
COMMERCE_TEST_ACCESS_TOKEN=

# Portable production data plane (Neon Postgres)
DATABASE_URL=

# Client-owned Stripe Connect Standard, test mode first
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECTED_ACCOUNT_ID=

# Passwordless customer access and protected background workers
CUSTOMER_AUTH_SECRET=
COMMERCE_WORKER_SECRET=

# Private Cloudflare R2 customer assets
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Resend commerce delivery. Separate from the existing inquiry sender until approved.
COMMERCE_RESEND_API_KEY=
COMMERCE_RESEND_WEBHOOK_SECRET=
COMMERCE_RESEND_FROM_EMAIL=
