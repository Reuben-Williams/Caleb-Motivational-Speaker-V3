# Public runtime
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_STAFF_AUTH_URL=
NEXT_PUBLIC_STAFF_AUTH_PUBLISHABLE_KEY=

# Native Neon inquiry data plane
DATABASE_URL=
NATIVE_INQUIRY_SITE_ID=
NATIVE_INQUIRY_RUNTIME_MEMBER_ID=
NATIVE_INQUIRY_CAPABILITIES_JSON=["forms.submit","customers.write","leads.write","messaging.enqueue"]

# Server spam verification
TURNSTILE_SECRET_KEY=

# Server durable rate limiting and idempotency
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_REDIS_NAMESPACE=
INQUIRY_HMAC_ACTIVE_KEY_ID=
INQUIRY_HMAC_SECRET=
INQUIRY_HMAC_PREVIOUS_KEYS_JSON={}

# Durable transactional email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=
INQUIRY_OUTBOX_WORKER_SECRET=
CRON_SECRET=

# Privacy retention worker
INQUIRY_RETENTION_HMAC_SECRET=
INQUIRY_RETENTION_WORKER_SECRET=

# Central staff identity; Neon remains authoritative for access
STAFF_AUTH_URL=
STAFF_AUTH_PUBLISHABLE_KEY=
STAFF_AUTH_EXPECTED_ISSUER=
STAFF_AUTH_EXPECTED_AUDIENCE=

# Managed control-plane installation runtime. The one-time exchange token is
# read from standard input only and must never be stored as an environment value.
BUILDER_CONTROL_PLANE_URL=
BUILDER_INSTALLATION_ID=
BUILDER_INSTALLATION_KEY_ID=
BUILDER_INSTALLATION_PRIVATE_JWK=
BUILDER_DATABASE_URL=

# Optional deployment adapter. Leave empty unless the host is explicitly trusted.
TRUSTED_CLIENT_IP_HEADER=
